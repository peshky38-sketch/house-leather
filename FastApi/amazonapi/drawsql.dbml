Project amazonapi {
  database_type: 'PostgreSQL'
}

Table member {
  id uuid [pk]
  name varchar(120) [not null]
  email varchar(320) [not null, unique]
  phone varchar(30)
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table member_password {
  id int [pk, increment]
  member_id uuid [not null, unique]
  password varchar(255) [not null, note: 'Password hash only']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table product {
  id int [pk, increment]
  name varchar(200) [not null]
  description text
  selling_price decimal(12,2) [not null]
  buying_price decimal(12,2) [not null]
  qty int [not null, default: 0]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table product_image {
  id int [pk, increment]
  product_id int [not null]
  cloudflare_image_id varchar(100) [not null, unique]
  image_url text [not null]
  is_default boolean [not null, default: false]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table client_order_status {
  id int [pk, increment]
  name varchar(40) [not null, unique]
  description text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table client_order {
  id int [pk, increment]
  member_id uuid [not null]
  client_order_status_id int [not null]
  total_selling_price decimal(12,2) [not null, default: 0]
  total_buying_price decimal(12,2) [not null, default: 0]
  total_profit decimal(12,2) [not null, default: 0]
  total_paid decimal(12,2) [not null, default: 0]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table client_order_product {
  id int [pk, increment]
  client_order_id int [not null]
  product_id int [not null]
  qty int [not null]
  unit_selling_price decimal(12,2) [not null]
  unit_buying_price decimal(12,2) [not null]
  total_selling_price decimal(12,2) [not null]
  total_buying_price decimal(12,2) [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (client_order_id, product_id) [unique]
  }
}

Ref: member_password.member_id - member.id
Ref: product_image.product_id > product.id
Ref: client_order.member_id > member.id
Ref: client_order.client_order_status_id > client_order_status.id
Ref: client_order_product.client_order_id > client_order.id
Ref: client_order_product.product_id > product.id