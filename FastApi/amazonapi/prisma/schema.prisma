generator client {
  provider                    = "prisma-client-py"
  enable_experimental_decimal = true
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  id              String          @id @default(uuid()) @db.Uuid
  name            String          @db.VarChar(120)
  email           String          @unique @db.VarChar(320)
  phone           String?         @db.VarChar(30)
  member_password MemberPassword?
  orders          ClientOrder[]
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @updatedAt @db.Timestamptz(6)

  @@map("member")
}

model MemberPassword {
  id         Int      @id @default(autoincrement())
  member_id  String   @unique @db.Uuid
  password   String   @db.VarChar(255)
  member     Member   @relation(fields: [member_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@map("member_password")
}

model Product {
  id            Int            @id @default(autoincrement())
  name          String         @db.VarChar(200)
  description   String?
  selling_price Decimal        @db.Decimal(12, 2)
  buying_price  Decimal        @db.Decimal(12, 2)
  qty           Int            @default(0)
  images        ProductImage[]
  order_items   ClientOrderProduct[]
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime       @updatedAt @db.Timestamptz(6)

  @@index([name])
  @@map("product")
}

model ProductImage {
  id                  Int      @id @default(autoincrement())
  product_id          Int
  cloudflare_image_id String   @unique @db.VarChar(100)
  image_url           String   @db.Text
  is_default          Boolean  @default(false)
  product             Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @updatedAt @db.Timestamptz(6)

  @@index([product_id])
  @@map("product_image")
}

model ClientOrderStatus {
  id           Int           @id @default(autoincrement())
  name         String        @unique @db.VarChar(40)
  description  String?
  client_orders ClientOrder[]
  created_at   DateTime      @default(now()) @db.Timestamptz(6)
  updated_at   DateTime      @updatedAt @db.Timestamptz(6)

  @@map("client_order_status")
}

model ClientOrder {
  id                      Int                  @id @default(autoincrement())
  member_id               String               @db.Uuid
  client_order_status_id  Int
  total_selling_price     Decimal              @default(0) @db.Decimal(12, 2)
  total_buying_price      Decimal              @default(0) @db.Decimal(12, 2)
  total_profit            Decimal              @default(0) @db.Decimal(12, 2)
  total_paid              Decimal              @default(0) @db.Decimal(12, 2)
  member                  Member               @relation(fields: [member_id], references: [id], onDelete: Restrict)
  client_order_status     ClientOrderStatus    @relation(fields: [client_order_status_id], references: [id], onDelete: Restrict)
  client_order_products   ClientOrderProduct[]
  created_at              DateTime             @default(now()) @db.Timestamptz(6)
  updated_at              DateTime             @updatedAt @db.Timestamptz(6)

  @@index([member_id, created_at])
  @@map("client_order")
}

model ClientOrderProduct {
  id                  Int         @id @default(autoincrement())
  client_order_id     Int
  product_id          Int
  qty                 Int
  unit_selling_price  Decimal     @db.Decimal(12, 2)
  unit_buying_price   Decimal     @db.Decimal(12, 2)
  total_selling_price Decimal     @db.Decimal(12, 2)
  total_buying_price  Decimal     @db.Decimal(12, 2)
  client_order        ClientOrder @relation(fields: [client_order_id], references: [id], onDelete: Cascade)
  product             Product     @relation(fields: [product_id], references: [id], onDelete: Restrict)
  created_at          DateTime    @default(now()) @db.Timestamptz(6)
  updated_at          DateTime    @updatedAt @db.Timestamptz(6)

  @@unique([client_order_id, product_id])
  @@index([product_id])
  @@map("client_order_product")
}